allow hal_fingerprint_default self:netlink_socket create_socket_perms_no_ioctl;
allow hal_fingerprint_default self:binder { call transfer };

binder_call(hal_fingerprint_default, vendor_hal_perf_default)

allow hal_fingerprint_default vendor_hal_perf_hwservice:hwservice_manager find;

allow hal_fingerprint_default fingerprintd_device:chr_file rw_file_perms;
allow hal_fingerprint_default silead_fpd_device:chr_file rw_file_perms;
allow hal_fingerprint_default tee_device:chr_file rw_file_perms;
allow hal_fingerprint_default vendor_qdsp_device:chr_file rw_file_perms;
allow hal_fingerprint_default vendor_xdsp_device:chr_file rw_file_perms;
allow hal_fingerprint_default egis_finger_device:chr_file rw_file_perms;
allow hal_fingerprint_default uhid_device:chr_file { open read write ioctl };
allow hal_fingerprint_default ion_device:chr_file map;

allow hal_fingerprint_default vendor_data_file:dir { search write create add_name };
allow hal_fingerprint_default vendor_data_file:file { read write create open getattr };

allow hal_fingerprint_default proc_touchpanel:dir search;
allow hal_fingerprint_default proc_touchpanel:file rw_file_perms;
allow hal_fingerprint_default proc:file r_file_perms;

allow hal_fingerprint_default sysfs_egis_input:dir r_dir_perms;
allow hal_fingerprint_default sysfs_egis_input:file rw_file_perms;
allow hal_fingerprint_default vendor_sysfs_battery_supply:dir search;
allow hal_fingerprint_default vendor_sysfs_battery_supply:file { read open getattr };

get_prop(hal_fingerprint_default, vendor_adsprpc_prop)
get_prop(hal_fingerprint_default, vendor_default_prop)
set_prop(hal_fingerprint_default, vendor_fingerprint_prop)
get_prop(hal_fingerprint_default, system_oplus_prop)
set_prop(hal_fingerprint_default, system_oplus_fingerprint_prop)
