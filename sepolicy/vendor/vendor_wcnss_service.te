allow vendor_wcnss_service init:unix_stream_socket connectto;
allow vendor_wcnss_service property_socket:sock_file write;
allow vendor_wcnss_service vendor_set_wlan_prop:property_service set;
allow vendor_wcnss_service sysfs:file { open read };
set_prop(vendor_wcnss_service, vendor_vold_prop)

allow vendor_wcnss_service mnt_vendor_file:dir search;
allow vendor_wcnss_service mnt_vendor_file:file r_file_perms;
