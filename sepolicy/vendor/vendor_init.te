allow vendor_init tmpfs:chr_file { read open };
allow vendor_init tmpfs:dir { create_dir_perms mounton };

allow vendor_init block_device:lnk_file setattr;

allow vendor_init proc_hung_task:file w_file_perms;
allow vendor_init proc_watermark_boost_factor:file rw_file_perms;

get_prop(vendor_init, vendor_db_security_prop)
set_prop(vendor_init, vendor_oem_bluetooth_prop)
set_prop(vendor_init, vendor_oem_wifi_prop)

# Silence OEM default_prop-fallback probes and vendor data symlink resolution during init
dontaudit vendor_init default_prop:file r_file_perms;
dontaudit vendor_init vendor_data_file:lnk_file read;

# `mount_all --early` (init.target.rc) makes fs_mgr probe /proc/cmdline and
# /metadata/gsi to detect a GSI boot. This device is non-GSI, so both probes
# fail and fs_mgr correctly proceeds without GSI handling. Silence them.
dontaudit vendor_init proc_cmdline:file getattr;
dontaudit vendor_init gsi_metadata_file:dir search;

# init touches the pty inherited while spawning a vendor service; not required
dontaudit vendor_init devpts:chr_file { read write };
