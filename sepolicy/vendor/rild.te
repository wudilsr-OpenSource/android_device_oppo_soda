allow rild vendor_data_file:dir rw_dir_perms;
allow rild vendor_data_file:file create_file_perms;

allow rild block_device:dir search;
allow rild mnt_vendor_file:dir search;

allow rild vendor_diag_device:chr_file rw_file_perms;

allow rild proc:file rw_file_perms;
allow rild proc_net:file w_file_perms;

allow rild oppo_reserve_file:dir r_dir_perms;
allow rild oppo_reserve_file:file r_file_perms;

# /mnt/vendor/opporeserve/radio is xattr-tagged oppo_reserve_radio_file
allow rild oppo_reserve_radio_file:dir r_dir_perms;
allow rild oppo_reserve_radio_file:file rw_file_perms;

set_prop(rild, vendor_rild_prop)

allow rild vendor_oplus_appradio_hwservice:hwservice_manager { find add };
allow rild vendor_oplus_ims_hwservice:hwservice_manager { find add };
allow rild vendor_oplus_radio_hwservice:hwservice_manager { find add };

# Silence probes of OEM properties that resolve to the default_prop fallback
dontaudit rild default_prop:file r_file_perms;
