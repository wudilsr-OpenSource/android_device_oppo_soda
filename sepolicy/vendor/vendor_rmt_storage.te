# rmt_storage accesses modem NVRAM block devices and sysfs UIO info
allow vendor_rmt_storage vendor_rmt_storage_block_dev:blk_file rw_file_perms;
allow vendor_rmt_storage sysfs:file r_file_perms;
allow vendor_rmt_storage vendor_sysfs_soc_sensitive:file r_file_perms;
allow vendor_rmt_storage proc:file r_file_perms;
